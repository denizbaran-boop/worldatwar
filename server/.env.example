PORT=3001

# Primary frontend origin (kept for backward compatibility and default allow-list).
FRONTEND_URL=http://localhost:3000

# Comma-separated exact origins allowed by CORS.
# Include your production frontend URL(s) and local dev URLs.
# Example:
# ALLOWED_ORIGINS=https://worldatwar.online,https://worldatwar.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://worldatwar.online,https://www.worldatwar.online

# Comma-separated regex patterns for dynamic preview domains.
# Defaults include Vercel previews: ^https://.*\.vercel\.app$
# Example:
# ALLOWED_ORIGIN_REGEX=^https://worldatwar-.*\.vercel\.app$,^https://.*\.vercel\.app$
ALLOWED_ORIGIN_REGEX=^https://.*\\.vercel\\.app$
